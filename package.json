{
  "name": "@lumeland/theme-simple-me",
  "version": "1.0.0",
  "description": "Lume theme to create a Linktree alternative.",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md",
    "theme.json"
  ],
  "type": "module",
  "exports": {
    ".": "./mod.ts"
  },
  "scripts": {
    "start": "lume build -s",
    "build": "rm -rf package && tsc -p . && cp -r src build && pnpm pack --out=package.tgz && rm -rf build && tar -xzf package.tgz && rm package.tgz && node build.js && oxfmt package/*",
    "fmt": "oxfmt ."
  },
  "dependencies": {
    "@lumeland/cms": "^1.0.0",
    "@lumeland/plugin-base-path": "^1.0.0",
    "@lumeland/plugin-cms": "^1.0.0",
    "@lumeland/plugin-favicon": "^1.0.0",
    "@lumeland/plugin-icons": "^1.0.0",
    "@lumeland/plugin-inline": "^1.0.0",
    "@lumeland/plugin-lightningcss": "^1.0.0",
    "@lumeland/plugin-metas": "^1.0.0"
  },
  "devDependencies": {
    "@lumeland/lume": "^4.0.0",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@lumeland/core": "^1.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
