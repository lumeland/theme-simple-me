{
  "name": "@lumeland/theme-simple-me",
  "version": "1.0.0-beta-1",
  "description": "Lume theme to create a Linktree alternative",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md",
    "theme.json"
  ],
  "type": "module",
  "exports": {
    ".": "./mod.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p . && cp -r src build",
    "fmt": "oxfmt ."
  },
  "dependencies": {
    "@lumeland/cms": "^1.0.0",
    "@lumeland/plugin-base-path": "workspace:^",
    "@lumeland/plugin-cms": "workspace:^",
    "@lumeland/plugin-favicon": "workspace:^",
    "@lumeland/plugin-icons": "workspace:^",
    "@lumeland/plugin-inline": "workspace:^",
    "@lumeland/plugin-lightningcss": "workspace:^",
    "@lumeland/plugin-metas": "workspace:^"
  },
  "devDependencies": {
    "@lumeland/lume": "workspace:^",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:^"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
